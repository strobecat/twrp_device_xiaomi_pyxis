# mount point  fstype device
/boot          emmc   /dev/block/bootdevice/by-name/boot
/dtbo          emmc   /dev/block/bootdevice/by-name/dtbo
/recovery      emmc   /dev/block/bootdevice/by-name/recovery
/firmware      vfat   /dev/block/bootdevice/by-name/modem
/cust          ext4   /dev/block/bootdevice/by-name/cust
/modem         emmc   /dev/block/bootdevice/by-name/modem
/bluetooth     emmc   /dev/block/bootdevice/by-name/bluetooth
/dsp           emmc   /dev/block/bootdevice/by-name/dsp
/efs1          emmc   /dev/block/bootdevice/by-name/modemst1
/efs2          emmc   /dev/block/bootdevice/by-name/modemst2
/efsc          emmc   /dev/block/bootdevice/by-name/fsc
/efsg          emmc   /dev/block/bootdevice/by-name/fsg
/persist       ext4   /dev/block/bootdevice/by-name/persist
/persist_image emmc   /dev/block/bootdevice/by-name/persist

# Removable storage
/usb_otg       vfat   /dev/block/sdg1
/sdcard1       auto   /dev/block/mmcblk0p1
